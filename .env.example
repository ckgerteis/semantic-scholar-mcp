# Copy to .env and fill in. Do NOT commit .env.
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# Query receipts (optional; both unset means off).
# MCP_RECEIPT_DIR names a FOLDER; each server writes its own hash-chained
# <server>.jsonl inside it. Preferred: one writer per file, so several servers
# running at once cannot fork one chain.
# MCP_RECEIPT_DIR=
# MCP_RECEIPT_SESSION=          # project or article slug; same across all servers
# MCP_RECEIPT_STRICT=           # 1 makes a logging failure raise
# MCP_RECEIPT_LOG=              # legacy single file; ignored when _DIR is set
